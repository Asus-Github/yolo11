import csv, json, re
from pathlib import Path
exp='"'"'TDW-CO-D3'"'"'
p=Path('"'"'runs/detect/runs/ablation'"'"')/exp/'"'"'results.csv'"'"'
rows=list(csv.DictReader(p.open()))
def get(r,n):
    for k,v in r.items():
        if k.strip()==n: return v
best=max(rows, key=lambda r: float(get(r,'"'"'metrics/mAP50-95(B)'"'"') or 0))
log=Path('"'"'runs'"'"')/f'"'"'TDW-CO-D3_train.log'"'"'
txt=log.read_text(errors='"'"'replace'"'"')
last='"'"''"'"'
for line in txt.splitlines():
    if '"'"'summary (fused)'"'"' in line or '"'"'summary:'"'"' in line:
        last=line
params_m=None; gflops=None
m=re.search(r'"'"'([0-9,]+) parameters.*?([0-9.]+) GFLOPs'"'"', last)
if m:
    params_m=round(int(m.group(1).replace('"'"','"'"', '"'"''"'"'))/1_000_000, 2)
    gflops=round(float(m.group(2)), 2)
out=dict(name=exp, epochs_recorded=len(rows), best_epoch=int(float(get(best,'"'"'epoch'"'"'))), precision=float(get(best,'"'"'metrics/precision(B)'"'"')), recall=float(get(best,'"'"'metrics/recall(B)'"'"')), map50=float(get(best,'"'"'metrics/mAP50(B)'"'"')), map50_95=float(get(best,'"'"'metrics/mAP50-95(B)'"'"')), params_m=params_m, gflops=gflops, wiou_logged='"'"'[ducc_wiou_train] BboxLoss.iou_type = wiou'"'"' in txt)
print(json.dumps(out, ensure_ascii=False))
